rules_version = '2';

// Reglas de seguridad de Firestore para la app de tareas de Mascota Market.
// Se pegan en Firebase Console > Firestore Database > Reglas > Publicar.
//
// Acceso (Firebase Authentication, Correo electrónico/contraseña):
// - Agustina: agustina@mascotamarket.app con su contraseña.
// - Las chicas: comparten equipo@mascotamarket.app. La clave del equipo se pone una sola vez por celular
//   y después cada una elige su nombre. Si hiciera falta cortar el acceso, se inhabilita ese usuario
//   o se le cambia la clave desde la consola.
// Cualquier otra cuenta (o nadie logueado) no puede leer ni escribir nada.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueada() {
      return request.auth != null;
    }

    function esAgustina() {
      return logueada() && request.auth.token.email == 'agustina@mascotamarket.app';
    }

    // Agustina o un celular con la sesión del equipo.
    function esDelEquipo() {
      return esAgustina()
        || (logueada() && request.auth.token.email == 'equipo@mascotamarket.app');
    }

    function registroValido() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['hecha', 'pospuesta']
        && request.resource.data.persona in ['ailin', 'sharon', 'sofia', 'agustina']
        // Solo Agustina puede registrar a su nombre.
        && (request.resource.data.persona != 'agustina' || esAgustina());
    }

    match /registros/{id} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo() && registroValido();
      // Solo se modifica o deshace lo marcado con la misma cuenta (la app además lo limita a cada chica).
      allow update: if esDelEquipo() && resource.data.uid == request.auth.uid && registroValido();
      allow delete: if esDelEquipo() && resource.data.uid == request.auth.uid;
    }

    // Tareas agregadas desde la app: todas las ven, solo Agustina las crea o quita.
    match /tareas/{id} {
      allow read: if esDelEquipo();
      allow write: if esAgustina();
    }

    // Notas de cambio de turno: todas las leen; se edita o borra solo lo escrito con la misma cuenta.
    match /notasTurno/{id} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.local in ['diagonal', 'rivadavia']
        && request.resource.data.persona in ['ailin', 'sharon', 'sofia', 'agustina']
        && (request.resource.data.persona != 'agustina' || esAgustina())
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1500;
      allow update: if esDelEquipo() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1500;
      allow delete: if esDelEquipo() && resource.data.uid == request.auth.uid;
    }

    // Agenda del calendario: todas la ven, solo Agustina agrega o quita.
    match /agenda/{id} {
      allow read: if esDelEquipo();
      allow write: if esAgustina();
    }

    // Pedidos de clientes: todas los ven, cargan, modifican y borran.
    match /pedidosClientes/{id} {
      allow read, delete: if esDelEquipo();
      allow create, update: if esDelEquipo()
        && request.resource.data.local in ['diagonal', 'rivadavia']
        && request.resource.data.estado in ['pendiente', 'llego', 'entregado', 'cancelado']
        && request.resource.data.pagoEstado in ['nada', 'sena', 'total']
        && request.resource.data.sena is number
        && request.resource.data.sena >= 0 && request.resource.data.sena <= 100000000
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 100000000
        && request.resource.data.cliente is string
        && request.resource.data.cliente.size() > 0 && request.resource.data.cliente.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 30
        && request.resource.data.producto is string
        && request.resource.data.producto.size() > 0 && request.resource.data.producto.size() <= 120
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 1 && request.resource.data.cantidad <= 999
        && request.resource.data.pago is string && request.resource.data.pago.size() <= 30
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 300;
    }

    // Pedidos de un día puntual (id = fecha): todas los ven, solo Agustina los cambia.
    match /pedidosDia/{fecha} {
      allow read: if esDelEquipo();
      allow delete: if esAgustina();
      allow create, update: if esAgustina()
        && request.resource.data.pide is string && request.resource.data.pide.size() <= 300
        && request.resource.data.llega is string && request.resource.data.llega.size() <= 300
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 300;
    }

    function notaEquipoValida() {
      return request.resource.data.tipo in ['texto', 'lista']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 3000
        && request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 500
        && request.resource.data.items is list && request.resource.data.items.size() <= 100
        && request.resource.data.creado is string
        && request.resource.data.editada is string
        && request.resource.data.editadaPor in ['', 'ailin', 'sharon', 'sofia', 'agustina']
        && request.resource.data.duracion in ['1d', '3d', '1s', '1m', 'fija']
        && request.resource.data.vence is string;
    }

    // Quien escribió la nota: Agustina con su cuenta; las chicas, con la cuenta del equipo desde la que se creó.
    function esCreadoraDe(nota) {
      return (nota.persona == 'agustina' && esAgustina())
        || (nota.persona != 'agustina' && logueada() && nota.uidCreadora == request.auth.uid);
    }

    // Notas del equipo (texto o lista): todas las ven, escriben, editan, tildan y borran.
    // Las de "hasta que yo la quite" (duracion 'fija') solo las borra quien las escribió,
    // y el tiempo de desaparición solo lo cambia ella.
    match /notasEquipo/{id} {
      allow read: if esDelEquipo();
      allow delete: if esDelEquipo() && (resource.data.duracion != 'fija' || esCreadoraDe(resource.data));
      allow create: if esDelEquipo() && notaEquipoValida()
        && request.resource.data.uidCreadora == request.auth.uid
        && request.resource.data.persona in ['ailin', 'sharon', 'sofia', 'agustina']
        && (request.resource.data.persona != 'agustina' || esAgustina());
      // Al editar no cambia quién la escribió ni cuándo.
      allow update: if esDelEquipo() && notaEquipoValida()
        && request.resource.data.persona == resource.data.persona
        && request.resource.data.uidCreadora == resource.data.uidCreadora
        && request.resource.data.creado == resource.data.creado
        && (esCreadoraDe(resource.data)
          || (request.resource.data.duracion == resource.data.duracion && request.resource.data.vence == resource.data.vence));
    }

    // Bloc de notas de Agustina: privado, nadie más lo puede leer.
    match /notasDuena/{id} {
      allow read, write: if esAgustina();
    }

    // Cualquier otra colección queda cerrada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
